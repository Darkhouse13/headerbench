exports[`compile: rule kinds > compiles request and response header ops into one modifyHeaders rule for all URLs 1`] = `
[
  {
    "action": {
      "requestHeaders": [
        {
          "header": "x-api-key",
          "operation": "set",
          "value": "abc123",
        },
        {
          "header": "cookie",
          "operation": "append",
          "value": "a=1",
        },
        {
          "header": "referer",
          "operation": "remove",
        },
      ],
      "responseHeaders": [
        {
          "header": "Access-Control-Allow-Origin",
          "operation": "set",
          "value": "*",
        },
        {
